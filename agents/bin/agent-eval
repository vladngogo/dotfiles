#!/usr/bin/env python3
"""agent-eval — run an agent against golden cases in isolated git worktrees,
grade the results, and compare runs case by case.

  agent-eval new <id>                      scaffold evals/cases/<id>.toml
  agent-eval run --label NAME [-k SUBSTR] [--runs N] [-j N] [--keep]
  agent-eval compare BASELINE CANDIDATE    exit 1 on any per-case regression

Run from the repo under test. Config: evals/config.toml. Results:
evals/results/<label>/ (summary.json, runs.jsonl, per-run logs).
"""
from __future__ import annotations

import argparse
import concurrent.futures as cf
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import threading
import time
from pathlib import Path

try:
    import tomllib
except ModuleNotFoundError:  # Python < 3.11
    try:
        import tomli as tomllib  # type: ignore[no-redef]
    except ModuleNotFoundError:
        sys.exit("agent-eval needs Python 3.11+ (or `pip install tomli`).")

EVALS = Path("evals")
CASES = EVALS / "cases"
RESULTS = EVALS / "results"

DEFAULT_CONFIG = {
    # Prompt arrives on stdin; cwd is the case worktree.
    "agent": "claude -p --output-format json --permission-mode acceptEdits",
    # Grader gets the grading prompt on stdin and must print JSON somewhere in stdout.
    "grader": "claude -p --output-format text --tools ''",
    "setup": "",
    "runs": 3,
    "jobs": 2,
    "timeout_s": 1800,
    "env": {},
}

CASE_TEMPLATE = '''\
# Golden case. Grade the outcome, not the path the agent took.
id = "{id}"
base = "HEAD"   # git ref the worktree starts from; pin a commit for stable evals

prompt = """
Exactly what the agent receives, e.g. the issue text.
"""

# Shell commands run in the worktree after the agent finishes; each must exit 0.
checks = [
  # "pytest -q",
]

# Hard rules. Any failure fails the run regardless of everything else.
must_not_break = [
  # "git diff --quiet {{base}} -- app/billing/",
]

# Judgment items, graded by the model grader against the diff and final output.
rubric = [
  # "The change handles CRLF line endings.",
]
'''

GRADER_PROMPT = """You are grading an AI coding agent's work. Judge only what the evidence shows.

TASK GIVEN TO THE AGENT:
{prompt}

AGENT'S FINAL OUTPUT (truncated):
{output}

DIFF AGAINST BASE (truncated):
{diff}

Grade each rubric item independently as pass or fail:
{items}

Reply with only this JSON, one entry per item in the same order:
{{"results": [{{"item": "<item text>", "pass": true, "reason": "<one sentence>"}}]}}
"""

_git_lock = threading.Lock()


def sh(cmd: str, cwd: Path, env: dict | None = None, stdin: str | None = None,
       timeout: float | None = None) -> subprocess.CompletedProcess:
    try:
        return subprocess.run(cmd, shell=True, cwd=cwd, env=env, input=stdin,
                              capture_output=True, text=True, timeout=timeout)
    except subprocess.TimeoutExpired as e:
        out = e.stdout.decode() if isinstance(e.stdout, bytes) else (e.stdout or "")
        return subprocess.CompletedProcess(cmd, 124, out, f"timeout after {timeout}s")


def load_config() -> dict:
    cfg = dict(DEFAULT_CONFIG)
    path = EVALS / "config.toml"
    if path.exists():
        cfg.update(tomllib.loads(path.read_text()))
    return cfg


def load_cases(filter_: str | None) -> list[dict]:
    cases = []
    for p in sorted(CASES.glob("*.toml")):
        case = tomllib.loads(p.read_text())
        case.setdefault("id", p.stem)
        if filter_ and filter_ not in case["id"]:
            continue
        cases.append(case)
    return cases


def parse_cost(stdout: str) -> float | None:
    """Pull total_cost_usd from the agent's JSON output, if it emits one."""
    for line in reversed(stdout.strip().splitlines()):
        try:
            data = json.loads(line)
        except json.JSONDecodeError:
            continue
        if isinstance(data, dict) and "total_cost_usd" in data:
            return float(data["total_cost_usd"])
    return None


def extract_json(text: str) -> dict | None:
    m = re.search(r"\{.*\}", text, re.S)
    if not m:
        return None
    try:
        return json.loads(m.group(0))
    except json.JSONDecodeError:
        return None


def grade_rubric(cfg: dict, case: dict, output: str, diff: str, scratch: Path) -> list[dict]:
    items = case.get("rubric", [])
    if not items:
        return []
    prompt = GRADER_PROMPT.format(
        prompt=case["prompt"].strip(),
        output=output[-8000:],
        diff=diff[:40000],
        items="\n".join(f"{i + 1}. {it}" for i, it in enumerate(items)),
    )
    proc = sh(cfg["grader"], cwd=scratch, stdin=prompt, timeout=600)
    data = extract_json(proc.stdout) or {}
    results = data.get("results", [])
    graded = []
    for i, item in enumerate(items):
        r = results[i] if i < len(results) and isinstance(results[i], dict) else {}
        graded.append({"item": item, "pass": bool(r.get("pass", False)),
                       "reason": r.get("reason", "grader returned no verdict")})
    return graded


def run_one(cfg: dict, case: dict, run_idx: int, slot: int, out_dir: Path,
            keep: bool) -> dict:
    repo = Path.cwd()
    base = case.get("base", "HEAD")
    wt = Path(tempfile.mkdtemp(prefix=f"eval-{case['id']}-{run_idx}-"))
    log_dir = out_dir / "logs" / f"{case['id']}.{run_idx}"
    log_dir.mkdir(parents=True, exist_ok=True)

    with _git_lock:
        add = sh(f"git worktree add --detach {wt} {base}", cwd=repo)
    if add.returncode != 0:
        return {"case": case["id"], "run": run_idx, "pass": False,
                "error": f"worktree add failed: {add.stderr.strip()}"}

    env = os.environ.copy()
    env["EVAL_SLOT"] = str(slot)
    for k, v in cfg.get("env", {}).items():
        env[k] = str(v).format(slot=slot)

    def fmt(cmd: str) -> str:
        return cmd.replace("{base}", base)

    result: dict = {"case": case["id"], "run": run_idx}
    try:
        if cfg.get("setup"):
            s = sh(cfg["setup"], cwd=wt, env=env, timeout=cfg["timeout_s"])
            (log_dir / "setup.log").write_text(s.stdout + s.stderr)
            if s.returncode != 0:
                result.update(**{"pass": False, "error": "setup failed"})
                return result

        t0 = time.monotonic()
        agent = sh(cfg["agent"], cwd=wt, env=env, stdin=case["prompt"],
                   timeout=cfg["timeout_s"])
        result["wall_s"] = round(time.monotonic() - t0, 1)
        result["agent_exit"] = agent.returncode
        result["cost_usd"] = parse_cost(agent.stdout)
        (log_dir / "agent.out").write_text(agent.stdout)
        (log_dir / "agent.err").write_text(agent.stderr)

        sh("git add -A", cwd=wt)
        diff = sh(f"git diff --cached {base}", cwd=wt).stdout
        (log_dir / "diff.patch").write_text(diff)

        def run_checks(cmds: list[str]) -> list[dict]:
            out = []
            for c in cmds:
                p = sh(fmt(c), cwd=wt, env=env, timeout=cfg["timeout_s"])
                out.append({"cmd": c, "pass": p.returncode == 0,
                            "tail": (p.stdout + p.stderr)[-1500:]})
            return out

        result["checks"] = run_checks(case.get("checks", []))
        result["must_not_break"] = run_checks(case.get("must_not_break", []))
        result["rubric"] = grade_rubric(cfg, case, agent.stdout, diff, log_dir)

        result["violation"] = not all(c["pass"] for c in result["must_not_break"])
        result["pass"] = (agent.returncode == 0 and not result["violation"]
                          and all(c["pass"] for c in result["checks"])
                          and all(r["pass"] for r in result["rubric"]))
        return result
    finally:
        if keep:
            result["worktree"] = str(wt)
        else:
            with _git_lock:
                sh(f"git worktree remove --force {wt}", cwd=repo)
            shutil.rmtree(wt, ignore_errors=True)


def summarize(runs: list[dict]) -> dict:
    by_case: dict[str, dict] = {}
    for r in runs:
        s = by_case.setdefault(r["case"], {"passed": 0, "runs": 0, "violations": 0,
                                           "cost": [], "wall": []})
        s["runs"] += 1
        s["passed"] += int(r.get("pass", False))
        s["violations"] += int(r.get("violation", False))
        if r.get("cost_usd") is not None:
            s["cost"].append(r["cost_usd"])
        if r.get("wall_s") is not None:
            s["wall"].append(r["wall_s"])
    summary = {}
    for cid, s in sorted(by_case.items()):
        summary[cid] = {
            "pass_rate": s["passed"] / s["runs"],
            "passed": s["passed"], "runs": s["runs"], "violations": s["violations"],
            "mean_cost_usd": round(sum(s["cost"]) / len(s["cost"]), 4) if s["cost"] else None,
            "mean_wall_s": round(sum(s["wall"]) / len(s["wall"]), 1) if s["wall"] else None,
        }
    return summary


def print_summary(summary: dict) -> None:
    print(f"\n{'case':<28}{'pass':>8}{'viol':>6}{'cost$':>9}{'wall s':>9}")
    for cid, s in summary.items():
        cost = "-" if s["mean_cost_usd"] is None else f"{s['mean_cost_usd']:.3f}"
        wall = "-" if s["mean_wall_s"] is None else f"{s['mean_wall_s']:.0f}"
        print(f"{cid:<28}{s['passed']:>4}/{s['runs']:<3}{s['violations']:>6}{cost:>9}{wall:>9}")
    total = sum(s["passed"] for s in summary.values())
    n = sum(s["runs"] for s in summary.values())
    print(f"{'TOTAL':<28}{total:>4}/{n:<3}")


def cmd_new(args) -> int:
    CASES.mkdir(parents=True, exist_ok=True)
    path = CASES / f"{args.id}.toml"
    if path.exists():
        sys.exit(f"{path} already exists")
    path.write_text(CASE_TEMPLATE.format(id=args.id))
    print(f"Created {path}")
    return 0


def cmd_run(args) -> int:
    if sh("git rev-parse --show-toplevel", cwd=Path.cwd()).returncode != 0:
        sys.exit("Run agent-eval from inside the git repo under test.")
    cfg = load_config()
    if args.runs:
        cfg["runs"] = args.runs
    if args.jobs:
        cfg["jobs"] = args.jobs
    cases = load_cases(args.k)
    if not cases:
        sys.exit(f"No cases in {CASES}/ (filter: {args.k!r}). Try `agent-eval new <id>`.")

    out_dir = RESULTS / args.label
    if out_dir.exists():
        sys.exit(f"{out_dir} exists; pick a new --label so results stay comparable.")
    out_dir.mkdir(parents=True)

    jobs = [(c, i) for c in cases for i in range(cfg["runs"])]
    print(f"{len(cases)} cases x {cfg['runs']} runs, {cfg['jobs']} in parallel → {out_dir}")
    runs: list[dict] = []
    slots = list(range(cfg["jobs"]))
    slot_lock = threading.Lock()

    def worker(job):
        with slot_lock:
            slot = slots.pop()
        try:
            return run_one(cfg, job[0], job[1], slot, out_dir, args.keep)
        finally:
            with slot_lock:
                slots.append(slot)

    with cf.ThreadPoolExecutor(max_workers=cfg["jobs"]) as pool, \
            open(out_dir / "runs.jsonl", "w") as fh:
        for r in pool.map(worker, jobs):
            runs.append(r)
            fh.write(json.dumps(r) + "\n")
            fh.flush()
            mark = "PASS" if r.get("pass") else ("VIOL" if r.get("violation") else "FAIL")
            print(f"  {mark} {r['case']} #{r['run']}" + (f"  ({r['error']})" if r.get("error") else ""))

    summary = summarize(runs)
    (out_dir / "summary.json").write_text(json.dumps(
        {"label": args.label, "config": cfg, "cases": summary}, indent=2))
    print_summary(summary)
    return 0


def cmd_compare(args) -> int:
    def load(label: str) -> dict:
        p = RESULTS / label / "summary.json"
        if not p.exists():
            sys.exit(f"No results for {label!r} ({p})")
        return json.loads(p.read_text())["cases"]

    base, cand = load(args.baseline), load(args.candidate)
    regressed = False
    print(f"{'case':<28}{'base':>8}{'cand':>8}  note")
    for cid in sorted(set(base) | set(cand)):
        b, c = base.get(cid), cand.get(cid)
        fmt = lambda s: f"{s['passed']}/{s['runs']}" if s else "-"  # noqa: E731
        note = ""
        if b and not c:
            # Dropping a failing case must not silently clear a regression.
            note, regressed = "MISSING from candidate", True
        elif c and not b:
            note = "new (no baseline)"
        if b and c:
            if c["pass_rate"] < b["pass_rate"]:
                note, regressed = "REGRESSION", True
            elif c["pass_rate"] > b["pass_rate"]:
                note = "improved"
            if b["mean_cost_usd"] and c["mean_cost_usd"]:
                note += f"  cost {c['mean_cost_usd'] / b['mean_cost_usd'] - 1:+.0%}"
            if b["mean_wall_s"] and c["mean_wall_s"]:
                note += f"  wall {c['mean_wall_s'] / b['mean_wall_s'] - 1:+.0%}"
        if c and c["violations"]:
            note, regressed = f"VIOLATION x{c['violations']} " + note, True
        print(f"{cid:<28}{fmt(b):>8}{fmt(c):>8}  {note.strip()}")
    return 1 if regressed else 0


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)
    p = sub.add_parser("new")
    p.add_argument("id")
    p.set_defaults(fn=cmd_new)
    p = sub.add_parser("run")
    p.add_argument("--label", required=True, help="name for this run, e.g. baseline")
    p.add_argument("-k", help="only cases whose id contains this")
    p.add_argument("--runs", type=int, help="runs per case (default from config: 3)")
    p.add_argument("-j", "--jobs", type=int, help="parallel worktrees")
    p.add_argument("--keep", action="store_true", help="keep worktrees for inspection")
    p.set_defaults(fn=cmd_run)
    p = sub.add_parser("compare")
    p.add_argument("baseline")
    p.add_argument("candidate")
    p.set_defaults(fn=cmd_compare)
    args = ap.parse_args()
    return args.fn(args)


if __name__ == "__main__":
    sys.exit(main())
