#!/usr/bin/env python3
"""guard-bash — refuse risky shell commands issued by an agent.

1. git pushes that write to main/master, force-push, or push every branch.
2. Commands that touch credential files (~/.ssh, ~/.aws, gh config, .env,
   the keystash store ~/.secrets).
3. sudo (it can't prompt in an agent shell) and `pkill -f` (the pattern also
   matches the agent's own shell, whose command line contains it).

Input: a shell command as argv[1], or a Claude Code PreToolUse JSON payload on
stdin (tool_input.command). Exit 2 blocks; the stderr message is shown to the
agent so it can adjust.

The command is tokenized like a shell would (quotes, ;, &&, ||, |) and each
`git ... push` is checked by resolving the destination of every refspec, so
`+main`, `refs/heads/main`, `HEAD:main`, `:main` and `-uf` are all caught.

This prevents accidents, not a determined adversary: anything that hides the
command (scripts, aliases, eval, base64) is invisible, and the current branch
is read from `git -C <dir>` or the hook's cwd, so `cd other && git push` is
judged against the cwd's branch. Pair with server-side branch protection, and
use a sandbox if the agent itself is untrusted.
"""
from __future__ import annotations

import json
import re
import shlex
import subprocess
import sys

SECRET_PATTERNS = [
    re.compile(r"(^|[/~=])\.ssh(/|$)"),
    re.compile(r"(^|[/~=])\.aws(/|$)"),
    re.compile(r"(^|[/~=])\.secrets(/|$)"),
    re.compile(r"(^|/)\.config/gh(/|$)"),
    re.compile(r"(^|/)\.env(\.[^/]*)?$"),
]
SECRET_ALLOWED = re.compile(r"\.env\.(example|sample|template|dist)$")

PROTECTED = {"main", "master"}
SEPARATORS = {";", "&&", "||", "|", "|&", "&", "(", ")", "\n"}
GIT_OPTS_WITH_VALUE = {"-C", "-c", "--git-dir", "--work-tree", "--namespace"}
PUSH_OPTS_WITH_VALUE = {"-o", "--push-option", "--repo", "--receive-pack", "--exec"}
PUSH_ALL = {"--all", "--mirror", "--branches"}


def tokenize(cmd: str) -> list[str]:
    lex = shlex.shlex(cmd, posix=True, punctuation_chars=True)
    lex.whitespace_split = True
    try:
        return list(lex)
    except ValueError:  # unbalanced quotes: fall back to a plain split
        return cmd.split()


def segments(tokens: list[str]) -> list[list[str]]:
    out, cur = [], []
    for t in tokens:
        if t in SEPARATORS:
            if cur:
                out.append(cur)
            cur = []
        else:
            cur.append(t)
    if cur:
        out.append(cur)
    return out


def current_branch(git_dir: str | None) -> str:
    cmd = ["git"] + (["-C", git_dir] if git_dir else []) + ["rev-parse", "--abbrev-ref", "HEAD"]
    try:
        return subprocess.run(cmd, capture_output=True, text=True).stdout.strip()
    except OSError:
        return ""


def parse_git(seg: list[str]) -> tuple[str | None, list[str]] | None:
    """Return (dir from -C, push args) if this segment is a git push."""
    if "git" not in seg:
        return None
    i = seg.index("git") + 1
    git_dir = None
    while i < len(seg) and seg[i].startswith("-"):
        opt = seg[i]
        if opt in GIT_OPTS_WITH_VALUE:
            if opt == "-C" and i + 1 < len(seg):
                git_dir = seg[i + 1]
            i += 2
        else:
            i += 1
    if i < len(seg) and seg[i] == "push":
        return git_dir, seg[i + 1:]
    return None


def check_push(git_dir: str | None, args: list[str]) -> str | None:
    positional: list[str] = []
    skip = False
    tags_only = False
    for a in args:
        if skip:
            skip = False
            continue
        if a in PUSH_OPTS_WITH_VALUE:
            skip = True
            continue
        if a.startswith("--"):
            name = a.split("=", 1)[0]
            if name == "--force":
                return "force push. Use --force-with-lease, and only on your own branch."
            if name in PUSH_ALL:
                return f"{name} pushes every branch, including main/master."
            if name == "--tags":
                tags_only = True
            continue
        if a.startswith("-") and len(a) > 1:
            if "f" in a[1:]:
                return "force push. Use --force-with-lease, and only on your own branch."
            continue
        positional.append(a)

    # positional[0] is the remote: git gives it priority over --repo, so a
    # lone positional is the repository, never a refspec.
    refspecs = positional[1:]
    branch = None

    def branch_now() -> str:
        nonlocal branch
        if branch is None:
            branch = current_branch(git_dir)
        return branch

    if not refspecs:
        if not tags_only and branch_now() in PROTECTED:
            return f"current branch is {branch_now()}. Create a feature branch before pushing."
        return None

    for spec in refspecs:
        if spec.startswith("+"):
            return f"force push via '{spec}'. Use --force-with-lease, and only on your own branch."
        dst = spec.split(":", 1)[1] if ":" in spec else spec
        if dst in ("HEAD", "@"):
            dst = branch_now()
        dst = dst.removeprefix("refs/heads/")
        if dst in PROTECTED:
            return f"'{spec}' writes to {dst}. Push a feature branch and open a PR."
    return None


def check_secrets(tokens: list[str]) -> str | None:
    for t in tokens:
        for word in re.split(r"[<>]", t):
            if word and not SECRET_ALLOWED.search(word) and any(p.search(word) for p in SECRET_PATTERNS):
                return f"'{word}' looks like a credential path. Ask the user instead of reading it."
    return None


HEREDOC_START = re.compile(r"<<-?\s*\\?(['\"]?)([\w.-]+)\1")
REDIRECT = re.compile(r"^(&>>?|[<>]+[&|]?)$")
KEYWORDS = {"if", "then", "else", "elif", "do", "while", "until", "!", "{"}
# Commands that run another command, and their options that take a value.
WRAPPERS = {
    "env": {"-u", "--unset", "-C", "--chdir"},
    "time": {"-o", "--output", "-f", "--format"},
    "exec": {"-a"},
    "nohup": set(),
    "command": set(),
    "builtin": set(),
}
LOOKUP_OPTS = {"-v", "-V"}  # `command -v sudo` only looks the name up
ASSIGNMENT = re.compile(r"^\w+=")


def skip_heredocs(cmd: str, i: int, delims: list[str]) -> int:
    """Return the index of the newline ending the last pending heredoc body.

    `i` is the newline after the line that opened them. If a delimiter never
    appears, it wasn't a heredoc (`$((1<<2))`): keep the text in the scan.
    """
    end = i
    for delim in delims:
        while True:
            nxt = cmd.find("\n", end + 1)
            line = cmd[end + 1:nxt if nxt != -1 else len(cmd)]
            end = nxt if nxt != -1 else len(cmd)
            if line.strip(" \t") == delim:
                break
            if nxt == -1:
                return i
    return end


def one_line(cmd: str) -> str:
    """Drop heredoc bodies and comments; turn unquoted newlines into `;`.

    The tokenizer treats a newline as plain whitespace, which would hide the
    start of each command on later lines. Heredoc bodies and quoted text are
    data, so a root command written out for the user is not a sudo call.
    A `<<` inside quotes or a comment does not open a heredoc.
    """
    out: list[str] = []
    quote = None
    pending: list[str] = []
    i = 0
    while i < len(cmd):
        c = cmd[i]
        if c == "\\" and quote != "'" and i + 1 < len(cmd):
            if cmd[i + 1] != "\n":  # backslash-newline is a line continuation
                out.append(cmd[i:i + 2])
            i += 2
            continue
        if quote:
            if c == quote:
                quote = None
        elif c in "'\"":
            quote = c
        elif c == "#" and (i == 0 or cmd[i - 1].isspace()):
            while i < len(cmd) and cmd[i] != "\n":
                i += 1
            continue
        elif cmd.startswith("<<<", i):  # here-string: the next line is a command
            out.append("<<<")
            i += 3
            continue
        elif c == "<" and (m := HEREDOC_START.match(cmd, i)):
            pending.append(m.group(2))
            out.append(" ")
            i = m.end()
            continue
        elif c == "\n":
            if pending:
                i = skip_heredocs(cmd, i, pending)
                pending = []
            c = " ; "
        out.append(c)
        i += 1
    return "".join(out)


def command_word(seg: list[str]) -> tuple[str, list[str]]:
    i = 0
    wrapper = None
    while i < len(seg):
        t = seg[i]
        nxt = seg[i + 1] if i + 1 < len(seg) else ""
        if REDIRECT.match(t):  # operator and its target
            i += 2
            continue
        if t.isdigit() and REDIRECT.match(nxt):  # fd number, as in 2>file
            i += 1
            continue
        if t in KEYWORDS:
            wrapper = None
        elif t in WRAPPERS:
            wrapper = t
        elif wrapper and t.startswith("-"):
            if t.startswith("--"):
                if t in WRAPPERS[wrapper]:
                    i += 1
            else:
                # Short options cluster: `env -iu HOME` is `-i -u HOME`.
                for j, ch in enumerate(t[1:], 1):
                    if wrapper == "command" and "-" + ch in LOOKUP_OPTS:
                        return "", []
                    if "-" + ch in WRAPPERS[wrapper]:
                        if j == len(t) - 1:  # value is the next token
                            i += 1
                        break
        elif not ASSIGNMENT.match(t):
            break
        i += 1
    if i >= len(seg):
        return "", []
    return seg[i].rsplit("/", 1)[-1], seg[i + 1:]  # /usr/bin/sudo is sudo


def check_command(seg: list[str]) -> str | None:
    word, args = command_word(seg)
    if word == "sudo":
        return ("sudo can't prompt here. Give the user the root commands in one "
                "copy-paste block per host and wait for them to confirm.")
    if word == "pkill":
        for a in args:
            if a == "--":
                break
            # getopt accepts --f and --fu as abbreviations of --full
            long_full = a.startswith("--f") and "--full".startswith(a)
            short_f = a.startswith("-") and not a.startswith("--") and "f" in a[1:]
            if long_full or short_f:
                return ("pkill -f also matches this shell's own command line. List "
                        "with `pgrep -af <pattern>`, then `kill <pid>`.")
    return None


def check(cmd: str) -> str | None:
    tokens = tokenize(cmd)
    reason = check_secrets(tokens)
    if reason:
        return reason
    for seg in segments(tokens):
        parsed = parse_git(seg)
        if parsed:
            reason = check_push(*parsed)
            if reason:
                return reason
    for seg in segments(tokenize(one_line(cmd))):
        reason = check_command(seg)
        if reason:
            return reason
    return None


def main() -> int:
    if len(sys.argv) > 1:
        cmd = sys.argv[1]
    else:
        try:
            cmd = json.load(sys.stdin).get("tool_input", {}).get("command", "")
        except (json.JSONDecodeError, AttributeError):
            return 0
    reason = check(cmd or "")
    if reason:
        print(f"Blocked: {reason}", file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main())
