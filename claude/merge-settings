#!/usr/bin/env python3
"""merge-settings — add this repo's Claude Code settings to a local settings.json.

    merge-settings <repo settings.json> <target settings.json>

The target stays a local file because Claude Code (/config) and Corgi rewrite
it. Objects merge recursively, lists gain only the items they lack, and scalars
the target already has win. Hooks are keyed by command per event, so a repo
hook is added once however the local file groups it. Nothing is removed, so
re-running changes nothing.
"""
import json
import os
import sys
import tempfile


def merge(target, source):
    if isinstance(target, dict) and isinstance(source, dict):
        for key, value in source.items():
            target[key] = merge(target[key], value) if key in target else value
        return target
    if isinstance(target, list) and isinstance(source, list):
        return target + [item for item in source if item not in target]
    return target


def merge_hooks(target, source):
    # Comparing whole matcher groups would duplicate a repo hook whenever the
    # local file groups it differently, so compare the commands themselves.
    for event, groups in source.items():
        existing = target.setdefault(event, [])
        present = {hook.get("command") for group in existing for hook in group.get("hooks", [])}
        for group in groups:
            missing = [hook for hook in group.get("hooks", []) if hook.get("command") not in present]
            if missing:
                existing.append({**group, "hooks": missing})
                present.update(hook.get("command") for hook in missing)
    return target


def main(source_path, target_path):
    with open(source_path) as f:
        source = json.load(f)

    # A link left by the old installer points into this repo: replace it with a
    # copy, or Claude Code and Corgi would write their changes into the checkout.
    if os.path.islink(target_path):
        if os.path.realpath(target_path) != os.path.realpath(source_path):
            sys.exit(f"{target_path} is a symlink to somewhere else; leaving it alone.")
        os.unlink(target_path)

    current = {}
    if os.path.exists(target_path):
        with open(target_path) as f:
            try:
                current = json.load(f)
            except json.JSONDecodeError as e:
                sys.exit(f"{target_path} is not valid JSON ({e}); fix it and re-run.")

    merged = json.loads(json.dumps(current))
    hooks = source.pop("hooks", {})
    merged = merge(merged, source)
    if hooks:
        merged["hooks"] = merge_hooks(merged.get("hooks", {}), hooks)
    if os.path.exists(target_path) and merged == current:
        print(f"{target_path} already has the repo settings")
        return

    directory = os.path.dirname(os.path.abspath(target_path))
    os.makedirs(directory, exist_ok=True)
    mode = os.stat(target_path).st_mode & 0o777 if os.path.exists(target_path) else 0o600
    fd, tmp = tempfile.mkstemp(dir=directory, prefix=".settings.json.")
    try:
        with os.fdopen(fd, "w") as f:
            json.dump(merged, f, indent=2)
            f.write("\n")
        os.chmod(tmp, mode)
        os.replace(tmp, target_path)
    except BaseException:
        os.unlink(tmp)
        raise
    print(f"Merged {source_path} into {target_path}")


if __name__ == "__main__":
    if len(sys.argv) != 3:
        sys.exit(__doc__.strip().splitlines()[2].strip())
    main(sys.argv[1], sys.argv[2])
